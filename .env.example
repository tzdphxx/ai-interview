# LLM / voice provider keys
AI_BAILIAN_API_KEY=
AI_MODEL=qwen3.5-flash

# Optional OpenAI-compatible providers
PROVIDER_KIMI_API_KEY=
PROVIDER_KIMI_MODEL=kimi-latest
PROVIDER_DEEPSEEK_API_KEY=
PROVIDER_DEEPSEEK_MODEL=deepseek-chat
PROVIDER_GLM_API_KEY=
PROVIDER_GLM_MODEL=glm-4.5

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=interview_pilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# S3-compatible object storage
APP_STORAGE_ENDPOINT=http://localhost:9000
APP_STORAGE_ACCESS_KEY=minioadmin
APP_STORAGE_SECRET_KEY=minioadmin
APP_STORAGE_BUCKET=interview-pilot

# Voice interview tuning
# APP_VOICE_USER_UTTERANCE_DEBOUNCE_MS=1600
# APP_VOICE_ASR_SILENCE_MS=1000
